build/
install/
log/
__pycache__/
*.pyc
.claude/*
!.claude/skills/
# No trailing slash: a trailing slash matches only a real directory, so a
# `.sim` symlink -- handy for pointing a git worktree at the main checkout's
# clone -- would show up as untracked and could be committed by accident.
.sim
.venv-f1tenth/
.pytest_cache/
# `ros2 run tf2_tools view_frames` output, written into whatever folder it
# was run from.
frames_*.gv
frames_*.pdf
# Hand-made config backups. The calibration wizard keeps its own in
# ~/.ros/odom_calibration/backups/; git history keeps every committed version.
*.bak
*.bak.*
# sensor_logger recordings: large, per-car, never committed. Keep the README.
data_logs/*
!data_logs/README.md
